# Kopyalayın: backend/.env  (git'e eklenmez)
# BotFather token — asla commit etmeyin
TELEGRAM_BOT_TOKEN=

# Telegram user id (virgülle birden fazla): @userinfobot veya getUpdates
TELEGRAM_ALLOWED_USER_IDS=

# Webhook kullanacaksanız rastgele uzun bir secret
TELEGRAM_WEBHOOK_SECRET=

# Fotoğraf altında slug yoksa varsayılan konu
TELEGRAM_DEFAULT_TOPIC_SLUG=turkce_anlam

# Gemini Vision OCR (bos birakilirsa gemini-3.6-flash)
GEMINI_API_KEY=
GEMINI_OCR_MODEL=gemini-3.6-flash
