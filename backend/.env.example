# Kopyalayın: backend/.env  (git'e eklenmez)
# BotFather token — asla commit etmeyin
TELEGRAM_BOT_TOKEN=

# Telegram user id (virgülle birden fazla): @userinfobot veya getUpdates
TELEGRAM_ALLOWED_USER_IDS=

# Webhook kullanacaksanız rastgele uzun bir secret
TELEGRAM_WEBHOOK_SECRET=

# Fotoğraf altında slug yoksa varsayılan konu
TELEGRAM_DEFAULT_TOPIC_SLUG=turkce_anlam

# Gemini Vision OCR — varsayılan ucuz Lite (3.8 Flash'e düşmez).
# GEMINI_API_KEY: ücretsiz AI Studio anahtarı (önce bu).
# GEMINI_API_KEY_PAID: billing açık proje anahtarı; günlük ücretsiz kota 429 olunca buna geçilir.
GEMINI_API_KEY=
GEMINI_API_KEY_PAID=
GEMINI_OCR_MODEL=gemini-3.5-flash-lite
